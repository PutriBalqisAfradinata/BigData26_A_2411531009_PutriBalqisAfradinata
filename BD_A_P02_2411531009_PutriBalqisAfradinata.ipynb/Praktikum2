      "source": [
        "def parse_tanggal(x):\n",
        "    if pd.isna(x):\n",
        "        return pd.NaT\n",
        "\n",
        "    x = str(x).strip()\n",
        "\n",
        "    for fmt in (\"%Y-%m-%d\", \"%d/%m/%Y\", \"%d-%m-%Y\"):\n",
        "        try:\n",
        "            return pd.to_datetime(x, format=fmt)\n",
        "        except ValueError:\n",
        "            pass\n",
        "\n",
        "    return pd.NaT\n",
        "\n",
        "df[\"transaction_date\"] = df[\"transaction_date\"].apply(parse_tanggal)\n",
        "df[\"transaction_date\"] = df[\"transaction_date\"].dt.strftime(\"%Y-%m-%d\")"
