    {
      "cell_type": "code",
      "source": [
        "def parse_tanggal(x):\n",
        "    for fmt in (\"%Y-%m-%d\", \"%d/%m/%Y\", \"%d-%m-%Y\"):\n",
        "        try:\n",
        "            return pd.to_datetime(x, format=fmt)\n",
        "        except ValueError:\n",
        "            continue\n",
        "    return pd.NaT\n",
        "\n",
        "df[\"transaction_date\"] = df[\"transaction_date\"].apply(parse_tanggal).dt.strftime(\"%Y-%m-%d\")"
      ],
