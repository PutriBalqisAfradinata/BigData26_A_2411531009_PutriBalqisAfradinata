    {
      "cell_type": "code",
      "source": [
        "def bersihkan_harga(x):\n",
        "    if pd.isna(x):\n",
        "        return np.nan\n",
        "    x = str(x).strip().replace(\"Rp\", \"\").replace(\".\", \"\").replace(\",\", \".\")\n",
        "    try:\n",
        "        return float(x)\n",
        "    except ValueError:\n",
        "        return np.nan\n",
        "\n",
        "df[\"price\"] = df[\"price\"].apply(bersihkan_harga)"
      ],
      "metadata": {
        "id": "m_xPPyoqIIbC"
